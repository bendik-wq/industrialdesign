{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealflow",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "dealflow", "database_id": "66670c65-c5ea-4f51-8c3e-5b1d3e9d227a" }
  ],
  "ai": { "binding": "AI" }
  // Secrets: DASHBOARD_PASSWORD (required: first-run setup key and session signing), API_TOKEN (admin scripts),
  // SESSION_SECRET (optional: separate session signing key), ANTHROPIC_API_KEY (Claude; otherwise Workers AI).
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealflow",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "dealflow", "database_id": "66670c65-c5ea-4f51-8c3e-5b1d3e9d227a" }
  ]
  // Secret: DASHBOARD_PASSWORD (wrangler secret put DASHBOARD_PASSWORD)
}

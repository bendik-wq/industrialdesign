{
  // G&L M&A Advisory VSL funnel. Deploy with `npm run deploy` (see README.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "owners-vsl-funnel",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Serve only via the custom domains (apply./live./data.grosfjeld-li.com), not the public
  // *.workers.dev URL, so /admin can't be reached around a domain-level firewall or Access rule.
  "workers_dev": false,

  // Static pages + assets. The Worker runs first for every HTML route so it can
  // log the page view server-side, set first-party cookies, assign A/B variants
  // and inject per-visitor config. /assets/* is served straight from the edge.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  },

  // The deployed version id: a fallback build id for versioned asset URLs (/assets/x.js?v=…, src/infra/build.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Workers AI: Whisper speech-to-text for "talk instead of type" in in-app browsers.
  "ai": { "binding": "AI" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "owners-vsl-funnel",
      "database_id": "aa995716-e0e5-48be-ad33-523a43c121a3",
      "migrations_dir": "migrations"
    }
  ],

  // Rooms (src/rooms): one Durable Object per video room for signalling and state over hibernating WebSockets.
  // Media runs on Cloudflare Realtime (SFU + TURN); its keys are settings (REALTIME_*), never sent to browsers.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }] },
  "migrations": [{ "tag": "rooms-v1", "new_sqlite_classes": ["RoomDO"] }],

  // Optional: room recordings (the host's composited stage) are uploaded here in parts and become the replay.
  // Without the binding the host room offers the recording as a download instead.
  "r2_buckets": [{ "binding": "RECORDINGS", "bucket_name": "gl-room-recordings" }],

  // Email queue, abandoned-application detection and call reminders.
  "triggers": { "crons": ["*/5 * * * *"] },

  // ── Platform round, builder A: Queues and Workflows (both used only when their setting is on) ──
  // Send queue (src/infra/queue.ts, setting SEND_VIA_QUEUE): the cron and the pages hand emails, texts, AI call dials
  // and tracking forwards to gl-send; the consumer sends each with the cron's own functions. Messages that fail
  // max_retries times move to gl-send-dlq, whose consumer keeps them for Funnel HQ → Errors & cron (Retry button).
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "gl-send" }],
    "consumers": [
      { "queue": "gl-send", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "max_concurrency": 5, "dead_letter_queue": "gl-send-dlq" },
      { "queue": "gl-send-dlq", "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 3 }
    ]
  },
  // Live reminder workflow (src/live/reminder-flow.ts, setting LIVE_REMINDERS_VIA_WORKFLOW): one durable instance per
  // live registration (instance id = registration id) that sends its reminders at their moments.
  "workflows": [{ "name": "gl-live-reminders", "binding": "LIVE_REMINDER_FLOW", "class_name": "LiveReminderWorkflow" }],

  // Non-secret config. Secrets (API keys, passwords) go in `wrangler secret put`
  // or can be connected from the dashboard's Integrations tab.
  "vars": {
    "SITE_NAME": "",
    "PUBLIC_URL": "",
    "EMAIL_FROM": "",
    "EMAIL_REPLY_TO": "",
    "JOSH_WHATSAPP": "",
    "BOOKING_URL_A": "",
    "BOOKING_URL_B": "",
    "VSL_MAIN_SRC": "",
    "VSL_MAIN_POSTER": "",
    "VSL_BREAKOUT_SRC": "",
    "VSL_BREAKOUT_POSTER": "",
    "VSL_PRECALL_SRC": "",
    "POSTHOG_HOST": "",
    "CONSENT_REQUIRED_EU": "",
    "IP_ANONYMIZE": ""
  }
}

{
  // G&L M&A Advisory VSL funnel. Deploy with `npm run deploy` (see README.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "owners-vsl-funnel",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Serve only via the custom domains (apply./live./data.grosfjeld-li.com), not the public
  // *.workers.dev URL, so /admin can't be reached around a domain-level firewall or Access rule.
  "workers_dev": false,

  // Static pages + assets. The Worker runs first for every HTML route so it can
  // log the page view server-side, set first-party cookies, assign A/B variants
  // and inject per-visitor config. /assets/* is served straight from the edge.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  },

  // The deployed version id: a fallback build id for versioned asset URLs (/assets/x.js?v=…, src/infra/build.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Workers AI: Whisper speech-to-text for "talk instead of type" in in-app browsers.
  "ai": { "binding": "AI" },

  // ── Cloudflare round, builder C: AI search (src/vectors). Vectorize index gl-knowledge (768 dims, cosine), filled with
  // Workers AI bge-base-en-v1.5 embeddings through the AI binding above. Nothing is indexed or queried unless the
  // VECTOR_SEARCH setting is on (ROOM_AI_HELPER for the room's AI draft). Vectorize doesn't run in `wrangler dev --local`:
  // every caller checks the binding and Funnel HQ says "not available here". AI Gateway needs no binding (setting AI_GATEWAY_ID).
  "vectorize": [{ "binding": "VECTORS", "index_name": "gl-knowledge" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "owners-vsl-funnel",
      "database_id": "aa995716-e0e5-48be-ad33-523a43c121a3",
      "migrations_dir": "migrations"
    }
  ],

  // Rooms (src/rooms): one Durable Object per video room for signalling and state over hibernating WebSockets.
  // Media runs on Cloudflare Realtime (SFU + TURN); its keys are settings (REALTIME_*), never sent to browsers.
  // G&L Studio adds STUDIO_EDITOR (the editor container's Durable Object, see the Studio block below).
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "STUDIO_EDITOR", "class_name": "StudioEditor" }
    ]
  },
  "migrations": [
    { "tag": "rooms-v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "studio-v1", "new_sqlite_classes": ["StudioEditor"] }
  ],

  // Optional: room recordings (the host's composited stage) are uploaded here in parts and become the replay.
  // Without the binding the host room offers the recording as a download instead.
  // G&L Studio adds STUDIO → bucket gl-studio (see the Studio block below).
  "r2_buckets": [
    { "binding": "RECORDINGS", "bucket_name": "gl-room-recordings" },
    { "binding": "STUDIO", "bucket_name": "gl-studio" }
  ],

  // Cloudflare platform round, builder B: Analytics Engine. A second copy of every first-party tracking event and room
  // quality report (src/infra/analytics-engine.ts), written only when the ANALYTICS_ENGINE setting is on. The dataset is
  // created on first write. Turnstile needs no binding (its keys and TURNSTILE_MODE are settings).
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "gl_events" }],
  // ── Cloudflare round, builder D: Workers KV + Browser Rendering ──
  // KV namespace GL_CACHE: the settings cache (setting KV_CACHE, off by default; src/settings.ts). Works locally (Miniflare).
  "kv_namespaces": [{ "binding": "CACHE", "id": "8f0bcd150bf740a1b71a17c66eca88a8" }],
  // Browser Rendering: Download PDF (setting PDF_RENDER) and the hourly funnel watchdog (setting WATCHDOG), both off by default.
  // The code checks for the binding and falls back (print to PDF stays; the watchdog records "no browser") when it is missing.
  "browser": { "binding": "BROWSER" },

  // Email queue, abandoned-application detection and call reminders.
  "triggers": { "crons": ["*/5 * * * *"] },

  // ── Platform round, builder A: Queues and Workflows (both used only when their setting is on) ──
  // Send queue (src/infra/queue.ts, setting SEND_VIA_QUEUE): the cron and the pages hand emails, texts, AI call dials
  // and tracking forwards to gl-send; the consumer sends each with the cron's own functions. Messages that fail
  // max_retries times move to gl-send-dlq, whose consumer keeps them for Funnel HQ → Errors & cron (Retry button).
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "gl-send" }],
    "consumers": [
      { "queue": "gl-send", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "max_concurrency": 5, "dead_letter_queue": "gl-send-dlq" },
      { "queue": "gl-send-dlq", "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 3 }
    ]
  },
  // Live reminder workflow (src/live/reminder-flow.ts, setting LIVE_REMINDERS_VIA_WORKFLOW): one durable instance per
  // live registration (instance id = registration id) that sends its reminders at their moments.
  "workflows": [
    { "name": "gl-live-reminders", "binding": "LIVE_REMINDER_FLOW", "class_name": "LiveReminderWorkflow" },
    { "name": "gl-studio-pipeline", "binding": "STUDIO_FLOW", "class_name": "StudioPipelineWorkflow" }
  ],

  // ── G&L Studio (src/studio): screen recordings with the face cam → Drive folder → automatic edit → back to Drive ──
  // R2 bucket gl-studio (binding STUDIO, in r2_buckets above): raw/<id>.<ext> (multipart while recording), edited/<id>.mp4,
  //   shorts/<id>-<n>.mp4, thumbs/, transcripts/, analysis/. Create it before the first deploy: npx wrangler r2 bucket create gl-studio
  // Workflow gl-studio-pipeline (binding STUDIO_FLOW, above): one durable run per video; the 5-minute cron covers anything not moving.
  // Container StudioEditor (Durable Object binding STUDIO_EDITOR and migration studio-v1, above): node + ffmpeg built from
  //   containers/studio-editor/Dockerfile; standard-4 = 4 vCPU, 12 GiB, 20 GB disk (the largest named type). One instance
  //   per video. `wrangler deploy` builds and pushes the image, so Docker must be running on the machine that deploys.
  //   Every caller checks the bindings: without them (tests, `wrangler dev` with containers off) Studio reports
  //   engine.ready=false with the reason, and recordings still save when STUDIO exists.
  "containers": [
    { "class_name": "StudioEditor", "image": "./containers/studio-editor/Dockerfile", "instance_type": "standard-4", "max_instances": 3 }
  ],
  // Local dev does not build the editor image (it is large); Studio says "Not available here" for the editor.
  "dev": { "enable_containers": false },

  // Non-secret config. Secrets (API keys, passwords) go in `wrangler secret put`
  // or can be connected from the dashboard's Integrations tab.
  "vars": {
    "SITE_NAME": "",
    "PUBLIC_URL": "",
    "EMAIL_FROM": "",
    "EMAIL_REPLY_TO": "",
    "JOSH_WHATSAPP": "",
    "BOOKING_URL_A": "",
    "BOOKING_URL_B": "",
    "VSL_MAIN_SRC": "",
    "VSL_MAIN_POSTER": "",
    "VSL_BREAKOUT_SRC": "",
    "VSL_BREAKOUT_POSTER": "",
    "VSL_PRECALL_SRC": "",
    "POSTHOG_HOST": "",
    "CONSENT_REQUIRED_EU": "",
    "IP_ANONYMIZE": ""
  }
}
